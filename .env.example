APP_NAME=instanweb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Produksi berjalan di balik reverse proxy (Railway/Heroku). Saat APP_ENV=production
# nilai ini otomatis dianggap "*" bila kosong. Isi manual jika perlu, contoh:
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2
TRUSTED_PROXIES=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=instanweb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Gmail SMTP untuk kode verifikasi email di produksi:
#   1. Aktifkan 2-Step Verification di akun Google.
#   2. Buat App Password (16 karakter), bukan password akun.
#   3. Isi variabel berikut di server produksi.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=akun@gmail.com
# MAIL_PASSWORD=app-password-google
# MAIL_FROM_ADDRESS=akun@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_TIMEOUT=15
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS WAJIB sama dengan MAIL_USERNAME atau alias Gmail yang
# sudah diverifikasi (Gmail Settings -> Accounts -> Send mail as).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gateway SMS verifikasi nomor (driver: log|http|twilio|vonage).
# "log" hanya untuk lokal; di produksi driver log ditolak agar kode tidak
# dianggap terkirim padahal hanya masuk file log.
SMS_DRIVER=log
# Driver http: gateway generik yang menerima JSON { to, target, message, sender }.
SMS_ENDPOINT=
SMS_TOKEN=
SMS_SENDER=
SMS_AUTH_HEADER=Authorization
SMS_AUTH_SCHEME=Bearer
SMS_TIMEOUT=10
# Twilio: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Vonage: https://dashboard.nexmo.com
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8000/google/callback
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=

# Tarif ongkos kirim berbasis jarak (Rupiah)
# Nilai base_fare/per_km di atas menjadi fallback bila tarif kurir tidak diatur.
SHIPPING_BASE_FARE=5000
SHIPPING_PER_KM=2500
SHIPPING_MINIMUM_KM=1
SHIPPING_DEFAULT_COURIER=JNE

# Tarif per kurir: biaya = base fare + (jarak km dibulatkan * tarif per km)
SHIPPING_JNE_BASE_FARE=6000
SHIPPING_JNE_PER_KM=2600
SHIPPING_JNT_BASE_FARE=5500
SHIPPING_JNT_PER_KM=2400
SHIPPING_SICEPAT_BASE_FARE=5000
SHIPPING_SICEPAT_PER_KM=2300
SHIPPING_ANTERAJA_BASE_FARE=4800
SHIPPING_ANTERAJA_PER_KM=2200
SHIPPING_COD_BASE_FARE=4000
SHIPPING_COD_PER_KM=2000